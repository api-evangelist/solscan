{
  "opencollection": "1.0.0",
  "info": {
    "name": "Solscan Pro Block API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Block",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get latest block data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro-api.solscan.io/v2.0/block/last"
          },
          "docs": "Get latest block data"
        }
      ]
    }
  ],
  "bundled": true
}