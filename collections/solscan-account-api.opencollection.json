          "info": {
            "name": "Get account details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://pro-api.solscan.io/v2.0/account/detail",
            "params": [
              {
                "name": "address",
                "value": "",
                "type": "query",
                "description": "Solana account address (base58)"
              }
            ]
          },
          "docs": "Get account details"
        },
        {
          "info": {
            "name": "Get decoded account data",
            "type": "http"
          },
          "http": {
