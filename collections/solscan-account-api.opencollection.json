{
  "opencollection": "1.0.0",
  "info": {
    "name": "Solscan Pro Account API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
