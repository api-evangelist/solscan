  "info": {
    "_postman_id": "af66093d-29a8-4947-aa43-0084c5638a00",
    "name": "Solscan Pro Account API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Solscan Pro API exposes decoded Solana on-chain data including account\ndetails, token holdings, transfers, DeFi activities, transaction details,\nblock info, and NFT collections. The Public API is a free, lower-rate-limit\nsurface; the Pro API is a paid service requiring an API token.\n\nAuthentication uses a token sent in the 'token' request header.\n\n\nContact Support:\n Name: Solscan API Documentation",
      "type": "text/plain"
    }
  }
